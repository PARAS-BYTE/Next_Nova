# ─── DATABASE ──────────────────────────────────────────────
# MongoDB Connection String (Both MONGO_URI and MONGODB_URI are supported)
# For local development:
MONGO_URI=mongodb://127.0.0.1:27017/nova_learn
# For Docker Compose: mongodb://mongodb:27017/nova_learn
# For MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@cluster.mongodb.net/nova_learn

# ─── AUTHENTICATION ─────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_replace_in_production
ADMIN_JWT_SECRET=your_admin_jwt_secret_here_replace_in_production
ADMIN_JWT_EXPIRE=7d

# ─── FAST MULTI-PROVIDER AI LLM ENGINES ────────────────────
# The app automatically detects whichever key is provided.
# You can configure any ONE (or more) of these providers:

# 1. Groq (Recommended for lightning-fast <1s responses):
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Google Gemini (Generous free tier, ultra-fast Gemini 2.0 / 1.5 Flash):
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# 3. Mistral AI (Fast mistral-small-latest default):
# Get key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here
# Optional model override (default: mistral-small-latest):
# MISTRAL_MODEL=mistral-small-latest

# 4. OpenAI:
OPENAI_API_KEY=your_openai_api_key_here

# ─── SERVER & ENVIRONMENT ──────────────────────────────────
PORT=3000
NODE_ENV=production
# SERVER_URL=http://localhost:3000
